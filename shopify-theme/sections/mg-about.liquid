<section id="nosotros" class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width mg-section mg-about">
    <div>
      <h2 class="mg-display mg-title">
        {{- section.settings.title_line_1 -}}
        {%- if section.settings.title_line_2 != blank -%}<br><span class="mg-accent">{{ section.settings.title_line_2 }}</span>{%- endif -%}
      </h2>
      {%- if section.settings.text != blank -%}<div class="mg-lead">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="mg-link" href="{{ settings.mg_instagram_url }}" target="_blank" rel="noopener">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <img src="{{ 'mg-monkey.png' | asset_url }}" alt="" width="220" height="220" loading="lazy">
  </div>
</section>

{% schema %}
{
  "name": "MG · Nosotros",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title_line_1", "label": "Título (blanco)", "default": "Hecho en Colombia." },
    { "type": "text", "id": "title_line_2", "label": "Título (amarillo)", "default": "Listo para el mundo." },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "text", "id": "link_label", "label": "Enlace a Instagram", "default": "Síguenos en @monkeygripco" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "presets": [{ "name": "MG · Nosotros" }]
}
{% endschema %}
