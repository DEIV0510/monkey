<section id="categorias" class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width mg-section">
    <div class="mg-head{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<p class="mg-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="mg-title">{{ section.settings.title | newline_to_br }}</h2>
    </div>

    <div class="mg-cats">
      {%- for block in section.blocks -%}
        {%- liquid
          assign cat_url = '#'
          assign cat_image = block.settings.image
          if block.settings.collection != blank
            assign cat_url = block.settings.collection.url
            if cat_image == blank
              assign cat_image = block.settings.collection.featured_image
            endif
          elsif block.settings.product != blank
            assign cat_url = block.settings.product.url
          endif
          if cat_image == blank and block.settings.product != blank
            assign cat_image = block.settings.product.featured_image
          endif
          assign cat_title = block.settings.title | default: block.settings.product.title
        -%}
        <a
          class="mg-cat{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          href="{{ cat_url }}"
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}
        >
          {%- if cat_image != blank -%}
            {{
              cat_image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                widths: '300, 450, 600, 800',
                sizes: '(min-width: 990px) 25vw, 50vw',
                alt: cat_title,
                style: block.settings.image_position
            }}
          {%- endif -%}
          <span class="mg-cat__body">
            <span class="mg-cat__num">{{ forloop.index | prepend: '0' }}</span>
            <span class="mg-cat__name">{{ cat_title }}</span>
            {%- if block.settings.text != blank -%}<span class="mg-cat__short">{{ block.settings.text }}</span>{%- endif -%}
            <span class="mg-cat__link">
              {{- block.settings.link_label -}}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MG · Categorías",
  "tag": "div",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Catálogo" },
    { "type": "textarea", "id": "title", "label": "Título", "default": "Equipamiento para\nrendir al máximo" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        { "type": "product", "id": "product", "label": "Producto" },
        { "type": "collection", "id": "collection", "label": "Colección (si existe, tiene prioridad)" },
        { "type": "image_picker", "id": "image", "label": "Imagen propia" },
        {
          "type": "select",
          "id": "image_position",
          "label": "Encuadre de la imagen",
          "default": "object-position: center",
          "options": [
            { "value": "object-position: center", "label": "Centro" },
            { "value": "object-position: 15% center", "label": "Izquierda" },
            { "value": "object-position: 85% center", "label": "Derecha" },
            { "value": "object-position: center top", "label": "Arriba" }
          ]
        },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "text", "id": "text", "label": "Frase corta" },
        { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver colección" }
      ]
    }
  ],
  "presets": [
    { "name": "MG · Categorías", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }] }
  ]
}
{% endschema %}
