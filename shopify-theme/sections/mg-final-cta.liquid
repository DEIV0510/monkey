<section class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width mg-section">
    <div class="mg-final{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<p class="mg-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="mg-title">{{ section.settings.title | newline_to_br }}</h2>
      {%- if section.settings.text != blank -%}<p class="mg-lead">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="mg-actions">
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button button--primary">
            {{- section.settings.button_label -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MG · Llamado final",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Monkey Grip" },
    { "type": "textarea", "id": "title", "label": "Título", "default": "¿Listo para mejorar\ntu rendimiento?" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Comprar ahora" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "presets": [{ "name": "MG · Llamado final" }]
}
{% endschema %}
