{%- liquid
  assign product = section.settings.product
  assign option_key = 'option1'
  if product != blank
    for option in product.options_with_values
      if option.name == section.settings.option_name
        assign option_key = 'option' | append: option.position
      endif
    endfor
    assign first_variant = product.selected_or_first_available_variant
    assign first_image = first_variant.featured_image | default: product.featured_image
  endif
  assign color_lines = section.settings.color_map | newline_to_br | split: '<br />'
-%}
<section id="{{ section.settings.anchor | default: 'grips' }}" class="color-{{ section.settings.color_scheme }} gradient">
  <mg-grip-showcase class="page-width mg-section mg-grip">
    <div class="mg-stage">
      <div class="mg-stage__glow" data-glow></div>
      {%- if product != blank -%}
        <span class="mg-stage__label">Color: <b data-label>{{ first_variant[option_key] }}</b></span>
        {%- if first_image != blank -%}
          {{
            first_image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '450, 700, 1000',
              sizes: '(min-width: 990px) 560px, 92vw',
              alt: product.title,
              data-stage: true
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="{% if settings.animations_reveal_on_scroll %}scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<p class="mg-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="mg-title">{{ section.settings.title | newline_to_br }}</h2>
      {%- if section.settings.text != blank -%}<p class="mg-lead">{{ section.settings.text }}</p>{%- endif -%}

      {%- if product != blank and product.has_only_default_variant == false -%}
        <div class="mg-swatches" role="radiogroup" aria-label="{{ section.settings.option_name | escape }}">
          {%- assign seen = '|' -%}
          {%- for variant in product.variants -%}
            {%- liquid
              assign value = variant[option_key]
              assign marker = '|' | append: value | append: '|'
              if seen contains marker
                continue
              endif
              assign seen = seen | append: value | append: '|'
              assign variant_image = variant.featured_image | default: product.featured_image
              assign hex = '#3a3a3a'
              for line in color_lines
                assign pair = line | strip | split: ':'
                if pair[0] == value
                  assign hex = pair[1] | strip
                endif
              endfor
            -%}
            <button
              type="button"
              class="mg-swatch{% if variant.id == first_variant.id %} is-active{% endif %}"
              style="background: {{ hex }};"
              role="radio"
              aria-checked="{% if variant.id == first_variant.id %}true{% else %}false{% endif %}"
              aria-label="{{ value | escape }}"
              data-label="{{ value | escape }}"
              data-hex="{{ hex }}"
              data-url="{{ variant.url }}"
              {% if variant_image != blank %}
                data-src="{{ variant_image | image_url: width: 1000 }}"
                data-srcset="{{ variant_image | image_url: width: 450 }} 450w, {{ variant_image | image_url: width: 700 }} 700w, {{ variant_image | image_url: width: 1000 }} 1000w"
              {% endif %}
            >
              <span class="mg-swatch__tip">{{ value }}</span>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="mg-check">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'mg-icon-check' %}{{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank and product != blank -%}
        <div class="mg-actions">
          <a href="{{ first_variant.url }}" class="button button--primary" data-cta>{{ section.settings.button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </mg-grip-showcase>
</section>

<script>
  if (!customElements.get('mg-grip-showcase')) {
    customElements.define(
      'mg-grip-showcase',
      class MgGripShowcase extends HTMLElement {
        connectedCallback() {
          this.img = this.querySelector('[data-stage]');
          this.glow = this.querySelector('[data-glow]');
          this.label = this.querySelector('[data-label]');
          this.cta = this.querySelector('[data-cta]');
          const active = this.querySelector('.mg-swatch.is-active');
          if (active && this.glow) this.glow.style.background = active.dataset.hex;
          this.querySelectorAll('.mg-swatch').forEach((swatch) => {
            swatch.addEventListener('click', () => this.select(swatch));
          });
        }

        select(swatch) {
          this.querySelectorAll('.mg-swatch').forEach((s) => {
            s.classList.toggle('is-active', s === swatch);
            s.setAttribute('aria-checked', s === swatch ? 'true' : 'false');
          });
          if (this.label) this.label.textContent = swatch.dataset.label;
          if (this.glow) this.glow.style.background = swatch.dataset.hex;
          if (this.cta) this.cta.href = swatch.dataset.url;
          if (!this.img || !swatch.dataset.src) return;
          this.img.classList.add('is-swapping');
          setTimeout(() => {
            this.img.srcset = swatch.dataset.srcset;
            this.img.src = swatch.dataset.src;
            this.img.alt = swatch.dataset.label;
            this.img.classList.remove('is-swapping');
          }, 200);
        }
      }
    );
  }
</script>

{% schema %}
{
  "name": "MG · Selector de color",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto" },
    { "type": "text", "id": "option_name", "label": "Nombre de la opción de color", "default": "Color" },
    {
      "type": "textarea",
      "id": "color_map",
      "label": "Colores (uno por línea: Nombre:#hex)",
      "default": "Amarillo:#FFEC00\nRojo:#E7302B\nRosa Neón:#FF3D68\nMorado:#5B2E8C\nLavanda:#B7A6DE\nCeleste:#7FD6EA\nNegro Cyan:#22B8D6\nVerde:#79C143"
    },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Producto insignia" },
    { "type": "textarea", "id": "title", "label": "Título", "default": "Tu agarre no\ndebería ser el\nlímite." },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Ver Grips" },
    { "type": "text", "id": "anchor", "label": "Ancla (id)", "default": "grips" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "blocks": [
    { "type": "feature", "name": "Beneficio", "settings": [{ "type": "text", "id": "text", "label": "Texto" }] }
  ],
  "presets": [{ "name": "MG · Selector de color" }]
}
{% endschema %}
