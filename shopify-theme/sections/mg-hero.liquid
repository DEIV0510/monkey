{%- liquid
  assign product = section.settings.product
  if product != blank
    assign hero_image = product.selected_or_first_available_variant.featured_image | default: product.featured_image
  endif
  assign group = 'hero-' | append: section.id
-%}
<section class="mg-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width mg-hero__grid">
    <div class="mg-hero__copy">
      {%- if section.settings.kicker != blank -%}<p class="mg-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="mg-display mg-hero__title">
        {{- section.settings.title_line_1 -}}
        {%- if section.settings.title_line_2 != blank -%}<br><span class="mg-accent">{{ section.settings.title_line_2 }}</span>{%- endif -%}
      </h2>
      {%- if section.settings.text != blank -%}<p class="mg-hero__sub">{{ section.settings.text }}</p>{%- endif -%}
      {%- if product != blank and product.price > 0 -%}
        <p class="mg-hero__price"><strong>{{ product.price | money_without_trailing_zeros }}</strong><span>{{ section.settings.price_note }}</span></p>
      {%- endif -%}
      <div class="mg-actions">
        {%- if section.settings.button_1_label != blank -%}
          <a href="{{ section.settings.button_1_link | default: product.url }}" class="button button--primary" data-mg-link="{{ group }}">{{ section.settings.button_1_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a href="{{ section.settings.button_2_link | default: '#productos' }}" class="button button--secondary">{{ section.settings.button_2_label }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="mg-hero__media">
      <div class="mg-hero__frame mg-media-light">
        {%- if hero_image != blank -%}
          {{
            hero_image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '640, 1200',
              sizes: '(min-width: 990px) 620px, 90vw',
              alt: product.title,
              data-mg-target: group
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if product != blank and section.settings.colors != blank -%}
        <div class="mg-hero__colors">
          <p>{{ section.settings.colors_label }} · <b data-mg-label="{{ group }}">{{ section.settings.colors | strip | split: '|' | first }}</b></p>
          {% render 'mg-color-swatches', product: product, colors: section.settings.colors, group: group %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MG · Hero",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto" },
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "Grips · Tecnología GRIPNEX™" },
    { "type": "text", "id": "title_line_1", "label": "Título (blanco)", "default": "Adherencia extrema." },
    { "type": "text", "id": "title_line_2", "label": "Título (amarillo)", "default": "Sin magnesio." },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "text", "id": "price_note", "label": "Nota junto al precio", "default": "COP por par · envío aparte" },
    { "type": "text", "id": "button_1_label", "label": "Botón principal", "default": "Comprar Grips" },
    { "type": "url", "id": "button_1_link", "label": "Enlace del botón principal (vacío = producto)" },
    { "type": "text", "id": "button_2_label", "label": "Botón secundario", "default": "Ver productos" },
    { "type": "text", "id": "button_2_link", "label": "Enlace del botón secundario", "default": "#productos" },
    { "type": "text", "id": "colors_label", "label": "Texto de colores", "default": "6 colores" },
    { "type": "textarea", "id": "colors", "label": "Colores (Nombre|#hex1|#hex2 por línea)" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "presets": [{ "name": "MG · Hero" }]
}
{% endschema %}
