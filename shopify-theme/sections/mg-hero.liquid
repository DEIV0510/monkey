{%- liquid
  assign hero_image = section.settings.image
  if hero_image == blank and section.settings.product != blank
    assign hero_image = section.settings.product.selected_or_first_available_variant.featured_image | default: section.settings.product.featured_image
  endif
-%}
<section class="mg-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width mg-hero__grid">
    <div class="{% if settings.animations_reveal_on_scroll %}scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.kicker != blank -%}
        <p class="mg-hero__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}
      <h2 class="mg-hero__title">
        {{- section.settings.title_line_1 -}}
        {%- if section.settings.title_line_2 != blank -%}<span>{{ section.settings.title_line_2 }}</span>{%- endif -%}
      </h2>
      {%- if section.settings.text != blank -%}
        <p class="mg-hero__sub">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="mg-actions">
        {%- if section.settings.button_1_label != blank -%}
          <a href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}" class="button button--primary">
            {{- section.settings.button_1_label -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a href="{{ section.settings.button_2_link | default: '#categorias' }}" class="button button--secondary">
            {{- section.settings.button_2_label -}}
          </a>
        {%- endif -%}
      </div>
      <ul class="mg-hero__trust">
        {%- for i in (1..3) -%}
          {%- liquid
            assign key = 'trust_' | append: i
            assign trust = section.settings[key]
          -%}
          {%- if trust != blank -%}
            <li>{% render 'mg-icon-check' %}{{ trust }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="mg-hero__visual">
      <div class="mg-hero__glow"></div>
      <div class="mg-hero__frame">
        {%- if hero_image != blank -%}
          {{
            hero_image
            | image_url: width: 1100
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '400, 600, 800, 1100',
              sizes: '(min-width: 990px) 520px, 84vw',
              alt: hero_image.alt
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if section.settings.tag_title != blank -%}
        <div class="mg-hero__tag">
          {{- section.settings.tag_title -}}
          {%- if section.settings.tag_text != blank -%}<small>{{ section.settings.tag_text }}</small>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MG · Hero",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "Performance Gear · CrossFit" },
    { "type": "text", "id": "title_line_1", "label": "Título (línea blanca)", "default": "Agarra más." },
    { "type": "text", "id": "title_line_2", "label": "Título (línea amarilla)", "default": "Rinde más." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Equipamiento premium diseñado para llevar tu rendimiento al siguiente nivel." },
    { "type": "text", "id": "button_1_label", "label": "Botón principal", "default": "Comprar ahora" },
    { "type": "url", "id": "button_1_link", "label": "Enlace del botón principal" },
    { "type": "text", "id": "button_2_label", "label": "Botón secundario", "default": "Ver productos" },
    { "type": "text", "id": "button_2_link", "label": "Enlace del botón secundario", "default": "#categorias" },
    { "type": "text", "id": "trust_1", "label": "Confianza 1", "default": "Diseño premium" },
    { "type": "text", "id": "trust_2", "label": "Confianza 2", "default": "Hecho en Colombia" },
    { "type": "text", "id": "trust_3", "label": "Confianza 3", "default": "Pensado para atletas" },
    { "type": "header", "content": "Imagen" },
    { "type": "product", "id": "product", "label": "Producto (usa su foto principal)" },
    { "type": "image_picker", "id": "image", "label": "Imagen propia (reemplaza la del producto)" },
    { "type": "text", "id": "tag_title", "label": "Etiqueta amarilla", "default": "Monkey Hand Grip" },
    { "type": "text", "id": "tag_text", "label": "Texto de la etiqueta", "default": "Caucho de alto rendimiento" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "presets": [{ "name": "MG · Hero" }]
}
{% endschema %}
