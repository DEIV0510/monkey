{%- comment -%}
  Grilla visual hacia Instagram con fotos reales de los productos.
  Lista para reemplazar por un feed conectado (app) más adelante.
{%- endcomment -%}
{%- liquid
  assign shown = 0
  assign max_photos = section.settings.limit
-%}
<section class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width mg-section">
    <div class="mg-insta__head{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="mg-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="mg-title">{{ section.settings.title | newline_to_br }}</h2>
      </div>
      <a href="{{ settings.mg_instagram_url }}" target="_blank" rel="noopener" class="button button--secondary">
        {{- settings.mg_instagram_handle -}}
      </a>
    </div>

    <div class="mg-insta">
      {%- for product in section.settings.products -%}
        {%- for image in product.images limit: section.settings.per_product -%}
          {%- if shown < max_photos -%}
            {%- assign shown = shown | plus: 1 -%}
            <a href="{{ settings.mg_instagram_url }}" target="_blank" rel="noopener" aria-label="{{ settings.mg_instagram_handle | escape }} en Instagram">
              {{ image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 400', sizes: '(min-width: 990px) 16vw, 33vw', alt: '' }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MG · Instagram",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Comunidad" },
    { "type": "textarea", "id": "title", "label": "Título", "default": "Sigue el\nmovimiento." },
    { "type": "product_list", "id": "products", "label": "Productos (se usan sus fotos)", "limit": 8 },
    { "type": "range", "id": "limit", "label": "Fotos a mostrar", "min": 3, "max": 12, "step": 3, "default": 6 },
    { "type": "range", "id": "per_product", "label": "Fotos por producto", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "presets": [{ "name": "MG · Instagram" }]
}
{% endschema %}
